# Run ./scripts/start.sh --init-env to create private Docker and ECI profiles.
# 运行 ./scripts/start.sh --init-env 生成 Docker 和 ECI 的私有配置文件。
# Write literal KEY=value assignments without quotes, export, or interpolation.
# 使用 KEY=value 格式填写原始值，不加引号、export，也不展开变量。
# The launcher validates explicit deployment environment overrides before saving them.
# 启动脚本会先校验显式传入的部署环境变量，再将有效覆盖值保存到配置文件。
# Configure models and web search per account in Settings; connect services in Plugin market.
# 模型和网页搜索请在设置中按账号配置；第三方服务请到插件市场连接。

# Host runtime: docker for local Docker or eci for Alibaba Cloud ECI.
# Host 运行模式：docker 表示本地 Docker，eci 表示阿里云弹性容器实例。
HARNESS_RUNTIME=docker
# Local Host image tag. ECI initialization sets go-bot/host:eci for the build step.
# Host 镜像的本地标签。ECI 初始化将其设为 go-bot/host:eci，供构建步骤使用。
HOST_IMAGE=go-bot/host:local
# Docker uses an account volume. ECI uses instance storage (container) or persistent NAS (nas).
# Docker 自动挂载账号卷。ECI 可以选择实例存储（container）或持久化 NAS（nas）。
HARNESS_STORAGE=container
# NAS mount target hostname. Required only for ECI with HARNESS_STORAGE=nas.
# NAS 挂载点域名，仅在 ECI 使用 HARNESS_STORAGE=nas 时必填。
NAS_MOUNT_TARGET=

# Bind address for a native Controller. Compose publishes the host port as 8080:8080.
# 原生 Controller 的监听地址。Compose 通过 8080:8080 发布宿主机端口。
CONTROLLER_LISTEN=127.0.0.1:8080

# Alibaba Cloud region for the ECI instance and image cache.
# ECI 实例和镜像缓存所在的阿里云地域。
ECI_REGION=cn-hangzhou
# Existing vSwitch ID for ECI.
# 供 ECI 使用的已有交换机 ID。
ECI_VSWITCH_ID=
# Existing security group ID. Allow Controller to reach the ECI private IP on TCP 8080.
# 已有安全组 ID。允许 Controller 通过私网访问 ECI 的 TCP 8080 端口。
ECI_SECURITY_GROUP_ID=
# Ready ECI image cache ID. buildeci.sh writes this value on success.
# 已就绪的 ECI 镜像缓存 ID。buildeci.sh 成功后会写入此值。
ECI_IMAGE_CACHE_ID=
# Alibaba Cloud RAM AccessKey ID used by Controller and buildeci.
# Controller 和 buildeci 使用的阿里云 RAM AccessKey ID。
ALIBABA_CLOUD_ACCESS_KEY_ID=
# Secret for the Alibaba Cloud AccessKey ID above.
# 上方阿里云 AccessKey ID 对应的 Secret。
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Full, versioned registry image reference for buildeci prepare or cache.
# buildeci prepare 或 cache 使用的完整镜像仓库地址，需指定版本。
REGISTRY_PUSH_IMAGE=
# Private registry username for ECI cache creation. Set both credentials or leave both empty.
# ECI 制作缓存时使用的私有镜像仓库用户名。用户名和密码须同时填写或同时留空。
REGISTRY_USERNAME=
# Private registry password for ECI cache creation.
# ECI 制作缓存时使用的私有镜像仓库密码。
REGISTRY_PASSWORD=
