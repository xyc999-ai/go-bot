# syntax=docker/dockerfile:1.7
FROM golang:1.26-trixie AS toolchain
FROM toolchain AS source
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=build_ca,required=false --mount=type=cache,target=/go/pkg/mod \
    if [ -s /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /etc/ssl/certs/ca-certificates.crt; fi; go mod download
COPY . .

FROM node:22-trixie-slim AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
COPY docs/providers.md /docs/providers.md
RUN npm run build

FROM source AS controller-source
COPY --from=frontend-build /frontend/dist ./frontend/dist
FROM controller-source AS controller-compile
ARG CONTROLLER_GOOS=linux CONTROLLER_GOARCH=amd64
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${CONTROLLER_GOOS} GOARCH=${CONTROLLER_GOARCH} go build -tags webui -trimpath -o /out/ ./cmd/controller ./cmd/buildeci
FROM scratch AS controller-binary
COPY --from=controller-compile /out/controller /controller
COPY --from=controller-compile /out/buildeci /buildeci

FROM controller-source AS controller-linux
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -tags webui -trimpath -o /linux/ ./cmd/controller ./cmd/buildeci

FROM docker:29-cli AS controller
COPY --from=controller-linux /linux/controller /usr/local/bin/controller
COPY --from=controller-linux /linux/buildeci /usr/local/bin/buildeci
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/go-bot/
ENTRYPOINT ["/usr/local/bin/controller"]
