# syntax=docker/dockerfile:1.7
FROM node:24.22.3-trixie-slim AS node
# Bootstrap modern trust roots before Debian's ca-certificates package exists.
RUN node -e 'process.stdout.write(require("tls").rootCertificates.join("\n"))' > /tmp/bootstrap-ca.crt

# Pure Cordis runtime dependencies; installation does not load business plugins
# and lifecycle scripts remain disabled. The Host starts Node only as needed.
FROM node AS cordis
WORKDIR /opt/cordis
COPY extensions/cordis/package.json extensions/cordis/pnpm-lock.yaml extensions/cordis/pnpm-workspace.yaml ./
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /tmp/bootstrap-ca.crt; fi; \
    npm --cafile=/tmp/bootstrap-ca.crt install --global --ignore-scripts --no-audit --no-fund pnpm@11.25.0 \
    && NODE_EXTRA_CA_CERTS=/tmp/bootstrap-ca.crt pnpm install --frozen-lockfile --prod --ignore-scripts
COPY extensions/cordis/src/ ./src/
COPY extensions/sdk/package.json extensions/sdk/index.mjs extensions/sdk/index.d.ts extensions/sdk/LICENSE extensions/sdk/README.md /opt/sdk/
FROM golang:1.26-trixie AS toolchain
FROM toolchain AS source
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=build_ca,required=false --mount=type=cache,target=/go/pkg/mod \
    if [ -s /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /etc/ssl/certs/ca-certificates.crt; fi; go mod download
COPY . .
FROM source AS compile
ARG TARGETOS=linux TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /out/host ./cmd/host

FROM debian:trixie-slim AS computer
ENV DEBIAN_FRONTEND=noninteractive
COPY --from=node /tmp/bootstrap-ca.crt /etc/ssl/certs/ca-certificates.crt
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /etc/ssl/certs/ca-certificates.crt; fi; \
    sed -i 's#http://deb.debian.org#https://deb.debian.org#g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt -o Acquire::Retries=5 update && apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt -o Acquire::Retries=5 install -y --no-install-recommends \
      ca-certificates bash git curl ripgrep tzdata libatomic1 python3 python3-pip python3-venv \
      chromium libicu76 fontconfig fonts-liberation fonts-noto-cjk fonts-crosextra-carlito fonts-crosextra-caladea \
      libreoffice-writer libreoffice-calc libreoffice-impress poppler-utils poppler-data qpdf mupdf-tools \
      tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/agent-venv \
    && if [ -s /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /etc/ssl/certs/ca-certificates.crt; fi
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV HOME=/root PATH="/opt/agent-venv/bin:${PATH}"
RUN python -m pip install --cert /etc/ssl/certs/ca-certificates.crt --no-cache-dir PyYAML==6.0.3 pypdf pdfplumber reportlab PyMuPDF pypdfium2 python-pptx numpy lxml defusedxml pdf2image Pillow pytesseract \
    && npm --cafile=/etc/ssl/certs/ca-certificates.crt install --global --ignore-scripts --no-audit --no-fund pdf-lib@1.17.1 pdfjs-dist@4.10.38
COPY build/fontconfig/60-office-fonts.conf /etc/fonts/conf.d/60-office-fonts.conf
RUN mkdir -p /root/harness && fc-cache -f

# Package resources are assembled with official installers in a disposable stage.
# The final Host ships wrapper packages only; package installation prepares each CLI.
FROM computer AS plugin-packages
COPY extensions/plugins/ /opt/plugins/
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then cat /run/secrets/build_ca >> /etc/ssl/certs/ca-certificates.crt; fi; \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt bash /opt/plugins/prepare-assets.sh

FROM computer AS host
COPY --from=plugin-packages /opt/plugins/agent-browser/ /usr/share/go-bot/plugins/agent-browser/
COPY --from=plugin-packages /opt/plugins/officecli/ /usr/share/go-bot/plugins/officecli/
COPY --from=plugin-packages /opt/plugins/x/ /usr/share/go-bot/plugins/x/
COPY --from=plugin-packages /opt/plugins/google-workspace/ /usr/share/go-bot/plugins/google-workspace/
COPY --from=plugin-packages /opt/plugins/gemini-api/ /usr/share/go-bot/plugins/gemini-api/

# Plugin runtime dependencies are shared; business modules load only after activation.
COPY --from=cordis /opt/cordis/ /usr/share/go-bot/cordis/
COPY --from=cordis /opt/sdk/ /usr/share/go-bot/sdk/
COPY --from=cordis /usr/local/lib/node_modules/pnpm /usr/local/lib/node_modules/pnpm
RUN node -e 'const fs = require("node:fs"), path = require("node:path"); const root = "/usr/local/lib/node_modules/pnpm"; fs.symlinkSync(path.join(root, require(root + "/package.json").bin.pnpm), "/usr/local/bin/pnpm")' \
    && pnpm --version

ENV NODE_PATH=/usr/local/lib/node_modules GIN_MODE=release DSH_HOME=/root/harness/.dsh DSH_AGENTS_HOME=/root/harness/.agents \
    AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
COPY --from=compile /out/host /usr/local/bin/host
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/go-bot/
COPY build/web-markdown/NOTICES /usr/share/doc/go-bot/web-markdown-NOTICES
WORKDIR /root/harness
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/host"]
