{
  "expo": {
    "name": "Go Bot",
    "slug": "go-bot-mobile",
    "version": "0.0.2",
    "userInterfaceStyle": "light",
    "experiments": {
      "tsconfigPaths": false
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.gobot.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your Go Bot server on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.gobot.mobile",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "./plugins/with-shared-source-inputs",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import photos to your Go Bot image library.",
          "cameraPermission": "Take a photo to update your Go Bot avatar.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-share",
        {}
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save conversation images to your photo library.",
          "granularPermissions": []
        }
      ],
      "expo-localization",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "icon": "./assets/app-icon.png"
  }
}
